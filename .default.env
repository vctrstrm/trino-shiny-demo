## DOCKER

# change to 0.0.0.0 to access from outside
DOCKER_HOST_APP_BIND_ADDR=127.0.0.1

## VAST CONFIG
VAST_DATA_ENDPOINTS=http://vip1:80,http://vip2:80,http://vip3:80,http://vip4:80
VAST_ENDPOINT=http://vip1:80
VAST_ACCESS_KEY=vast-access-key
VAST_SECRET_ACCESS_KEY=vast-secret-key
VAST_NUM_OF_SPLITS=4
VAST_NUM_OF_SUBSPLITS=8

## VAST ICEBERG TRINO CATALOG CONFIG
VAST_ICEBERG_NESSIE_URI=http://nessie:19120/api/v1
VAST_ICEBERG_NESSIE_DEFAULT_WAREHOUSE_DIR=default
VAST_ICEBERG_S3_ENDPOINT=http://vip1:80
VAST_ICEBERG_S3_BUCKET_NAME=vast-bucket

## NESSIE
NESSIE_VERSION=0.105.7
NESSIE_DOCKER_INTERNAL_API_URI=http://nessie:19120/api/v1
NESSIE_DOCKER_EXTERNAL_API_URI=http://localhost:19120/api/v1

## LOCAL S3 ICEBERG CONFIG
LOCAL_ICEBERG_NESSIE_DEFAULT_WAREHOUSE_DIR=default
LOCAL_S3_DOCKER_INTERNAL_ENDPOINT=http://s3local:9000
LOCAL_S3_DOCKER_EXTERNAL_ENDPOINT=http://localhost:9000
LOCAL_S3_ACCESS_KEY=dev-access-key
LOCAL_S3_SECRET_ACCESS_KEY=dev-secret-access-key
LOCAL_ICEBERG_S3_BUCKET_NAME=iceberg
LOCAL_MISC_S3_BUCKET_NAME=misc

## TRINO
TRINO_VERSION=475

# any catalogs listed will not be read (sometimes good to do to avoid startup issues)
TRINO_DISABLED_CATALOGS="vastdb,vastberg"